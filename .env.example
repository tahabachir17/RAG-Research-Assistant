# ============================================================
# RAG AI Research Papers Assistant - Environment Variables
# Copy this file to .env and fill in the values you need.
# Do not commit .env.
# ============================================================

# ------------------------------------------------------------
# Discovery: alphaXiv MCP + Groq query planning
# ------------------------------------------------------------
ALPHAXIV_MCP_COMMAND="npx -y mcp-remote https://api.alphaxiv.org/mcp/v1"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------------------------
# Optional discovery enrichments
# ------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=""
OPENALEX_EMAIL=""
PAPER_DISCOVERY_ENRICH_LIMIT="25"
PAPER_DISCOVERY_EMBEDDING_MODEL="all-MiniLM-L6-v2"

# ------------------------------------------------------------
# Optional Feyman fallback/integration
# ------------------------------------------------------------
FEYMAN_API_URL=""
FEYMAN_API_KEY=""
FEYMAN_DISCOVERY_COMMAND=""

# ------------------------------------------------------------
# Ingestion defaults
# ------------------------------------------------------------
DATA_DIR="data"
DEFAULT_DISCOVERY_PROVIDER="auto"
DEFAULT_MAX_RESULTS="5"

# ------------------------------------------------------------
# Future embeddings / vector store
# ------------------------------------------------------------
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIM="384"
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_COLLECTION="ai_papers"
QDRANT_PATH="data/qdrant"
ENABLE_FAITHFULNESS_VERIFIER="true"
JUDGE_MAX_TOKENS="2048"

# ------------------------------------------------------------
# Future retrieval settings
# ------------------------------------------------------------
DENSE_TOP_K="50"
SPARSE_TOP_K="50"
HYBRID_TOP_K="20"
RERANK_TOP_K="8"
MAX_CHUNK_TOKENS="512"
CHUNK_OVERLAP="80"

# ------------------------------------------------------------
# Future LLM/API/frontend settings
# ------------------------------------------------------------
LLM_PROVIDER="groq"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_MAX_TOKENS="1024"
LLM_TEMPERATURE="0.0"
LLM_REQUEST_TIMEOUT_SECONDS="20"
LLM_TRANSPORT_MAX_RETRIES="0"
LLM_RATE_LIMIT_MAX_WAIT_SECONDS="115"
LLM_RATE_LIMIT_DEFAULT_WAIT_SECONDS="5"
ENABLE_CORPUS_ENRICHMENT="true"
CORPUS_ENRICHMENT_MAX_RESULTS="2"
DISCOVERY_PROVIDER="auto"
FRONTEND_REQUEST_TIMEOUT_SECONDS="600"
ROUTER_PROVIDERS="groq,gemini,lmstudio"
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_MODEL="gemini-3.5-flash-lite"
LMSTUDIO_MODEL="qwen/qwen3-4b-2507"
JUDGE_PROVIDER="groq"
JUDGE_MODEL="llama-3.1-8b-instant"
JUDGE_MAX_TOKENS="2048"
JUDGE_TEMPERATURE="0.0"
RAGAS_REQUESTS_PER_SECOND="0.05"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LMSTUDIO_API_KEY="lm-studio"
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
OLLAMA_HOST=""
API_HOST="0.0.0.0"
API_PORT="8000"
STREAMLIT_PORT="8501"
